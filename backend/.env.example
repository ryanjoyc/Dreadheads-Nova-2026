# Local development only. Docker Compose uses its internal database URL.
API_PORT=8000
DB_PORT=55433
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# For optional host-based tools; containers do not use this host address.
# DATABASE_URL=postgresql+psycopg://nova:nova_local@127.0.0.1:55433/nova_sales
# Rush-hour agent (GET /rush-hours). Paste the team key; never commit .env.
# Without a key the endpoint still answers from the historical forecast and says so.
OPENROUTER_KEY="REDACTED"
# Optional: any tool-calling model id from https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
